# Copy this file to .env and fill in ONE provider key.  (Windows: copy .env.example .env)
# .env is git-ignored. Never commit real keys.

# --- Pick one (auto-detected in this order: Anthropic, OpenAI, Gemini, Groq, OpenRouter) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Optional overrides ---
# CODEWARDEN_PROVIDER=gemini
# CODEWARDEN_MODEL=gemini-flash-latest
# OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# GITHUB_TOKEN=            # only to raise GitHub download rate limits
