{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeWarden AI",
          "version": "1.0.0",
          "informationUri": "https://github.com/",
          "rules": [
            {
              "id": "CW-JS-SQLI-001",
              "name": "SqlInjection",
              "shortDescription": {
                "text": "SQL injection via string-built query"
              },
              "fullDescription": {
                "text": "A SQL statement is assembled with template-literal interpolation or string concatenation and then executed. Interpolated values are spliced into the SQL text instead of being sent as bound parameters."
              },
              "help": {
                "text": "Use parameterised queries / the driver's tagged-template API so values are always sent separately from SQL. Never pass user-built strings to raw/unsafe execution APIs. Escape LIKE wildcards if partial matching is needed, and validate input length/type."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CW-JS-AUTHZ-001",
              "name": "BrokenAccessControl",
              "shortDescription": {
                "text": "Privileged database client used without authenticating the caller (write path bypasses Row Level Security)"
              },
              "fullDescription": {
                "text": "A server/edge request handler performs database operations with a privileged credential (service role / admin key / direct DB connection) but never verifies who is calling or whether they own the records they reference."
              },
              "help": {
                "text": "Authenticate every request (verify the JWT from the Authorization header), then either query with a client scoped to the caller's token so RLS applies, or explicitly enforce ownership in the query. Reserve service-role keys for trusted back-office jobs."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-862"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CW-JS-XSS-001",
              "name": "CrossSiteScriptingXss",
              "shortDescription": {
                "text": "Cross-site scripting via dangerouslySetInnerHTML"
              },
              "fullDescription": {
                "text": "React's dangerouslySetInnerHTML renders a string as raw HTML, bypassing React's automatic output escaping. When the string contains user-supplied content, attacker-controlled markup and script handlers (e.g. <img src=x onerror=...>) execute in other users' browsers."
              },
              "help": {
                "text": "Render user content as text (React escapes it automatically). If limited formatting is truly required, sanitise with a vetted library such as DOMPurify using a strict allow-list, and add a Content-Security-Policy as defence in depth."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-79"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CW-SQL-RLS-004",
              "name": "DatabaseAccessControl",
              "shortDescription": {
                "text": "Privilege escalation: users can modify `role` on `profiles`"
              },
              "fullDescription": {
                "text": "An UPDATE policy allows users to edit their own row, and that row contains an authorisation column (e.g. `role`). RLS restricts which rows can be changed, not which columns."
              },
              "help": {
                "text": "Revoke UPDATE on the privileged column(s) from client roles and grant UPDATE only on user-editable columns, or enforce immutability with a BEFORE UPDATE trigger. Store roles in a separate table writable only by the service role."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-269"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CW-SQL-RLS-001",
              "name": "DatabaseAccessControl",
              "shortDescription": {
                "text": "Over-permissive RLS read policy on `tasks` (USING true)"
              },
              "fullDescription": {
                "text": "A Row Level Security SELECT policy uses `USING (true)`, which makes every row visible to every user in the granted role, regardless of who owns the data."
              },
              "help": {
                "text": "Replace `true` with a predicate that ties rows to the caller (ownership or project/team membership via auth.uid()). If some data must be public, expose it through a view containing only the non-sensitive columns."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-284"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CW-JS-MASS-001",
              "name": "MassAssignment",
              "shortDescription": {
                "text": "Mass assignment: request body written to the database unfiltered"
              },
              "fullDescription": {
                "text": "An object taken directly from the request body is passed to an update/insert call, so the client decides which columns are written."
              },
              "help": {
                "text": "Validate the payload with a schema and copy only an explicit allow-list of editable fields; derive ownership and identifiers from the authenticated session, never from the body."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-915"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CW-SQL-RLS-005",
              "name": "DatabaseAccessControl",
              "shortDescription": {
                "text": "RLS write policy on `tasks` does not verify access to parent `projects`"
              },
              "fullDescription": {
                "text": "INSERT/UPDATE policies check only the new row's owner column; the foreign key that links the row to a parent (project, task, organisation) is not validated against the caller's access."
              },
              "help": {
                "text": "Add a membership/ownership check on the parent in WITH CHECK (and USING for updates)."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CW-SQL-RLS-003",
              "name": "DatabaseAccessControl",
              "shortDescription": {
                "text": "RLS policy on `task_comments` does not scope rows to the current user"
              },
              "fullDescription": {
                "text": "The policy relies on an EXISTS/IN subquery that only checks that a related row exists, without comparing it to the authenticated user. It looks restrictive but filters nothing user-specific."
              },
              "help": {
                "text": "Make the subquery join to the parent and compare the parent's owner/membership with auth.uid()."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-863"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CW-SECRET-001",
              "name": "HardcodedSecrets",
              "shortDescription": {
                "text": "Hard-coded secret in source (Hard-coded credential: apiKey)"
              },
              "fullDescription": {
                "text": "A credential-like value (API key, token, password or private key) is embedded directly in source code instead of being loaded from a secret store or server-side environment variable."
              },
              "help": {
                "text": "Remove the value from source, rotate it if it was ever real, and load it at runtime from a server-side secret store or environment variable. Never place private keys in frontend code; move the privileged call behind a backend endpoint that holds the secret."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CW-JS-ERRLEAK-001",
              "name": "InformationDisclosure",
              "shortDescription": {
                "text": "Internal error details returned to the client"
              },
              "fullDescription": {
                "text": "Raw exception text (database/driver messages, stack traces) is serialised into HTTP responses."
              },
              "help": {
                "text": "Log the full error server-side with a correlation ID and return a generic message to the client."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-209"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "CW-CFG-DEBUG-001",
              "name": "SecurityMisconfiguration",
              "shortDescription": {
                "text": "Debug / verbose mode enabled in committed configuration"
              },
              "fullDescription": {
                "text": "Debug features and verbose logging are hard-coded on rather than driven by the build environment."
              },
              "help": {
                "text": "Derive debug flags from the build mode (e.g. import.meta.env.DEV / NODE_ENV) so production builds always disable them."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-489"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "CW-JS-CORS-001",
              "name": "SecurityMisconfiguration",
              "shortDescription": {
                "text": "Permissive CORS policy (Access-Control-Allow-Origin: *)"
              },
              "fullDescription": {
                "text": "The API allows requests from any origin."
              },
              "help": {
                "text": "Return an explicit allow-list of trusted origins and only echo the request Origin when it matches."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-942"
                ],
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
